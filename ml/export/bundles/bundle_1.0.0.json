        "P3": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0a96\u0abe\u0aa4\u0ac7 \u0ab8\u0acd\u0ab5\u0a9a\u0acd\u0a9b\u0aa4\u0abe \u0a85\u0a82\u0a97\u0ac7\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aad\u0abe\u0ab5 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0aac\u0aa6\u0ab2 \u0a86\u0aad\u0abe\u0ab0. \u0aa4\u0ac7 \u0aa6\u0ac8\u0aa8\u0abf\u0a95 \u0a9c\u0abe\u0ab3\u0ab5\u0aa3\u0ac0 \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1\u0aae\u0abe\u0a82 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2 \u0a9b\u0ac7."
      },
      "fare": {
        "P1": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0a96\u0abe\u0aa4\u0ac7 \u0aad\u0abe\u0aa1\u0abe/\u0a9f\u0abf\u0a95\u0abf\u0a9f \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0a86\u0aaa\u0aa8\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0ab8\u0acd\u0a9f\u0ac7\u0ab6\u0aa8 \u0ab8\u0ac1\u0aaa\u0ab0\u0ab5\u0abe\u0a88\u0a9d\u0ab0\u0aa8\u0ac7 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7. \u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0ab8\u0aae\u0abe\u0aa7\u0abe\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 {station} \u0aa8\u0abe \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95 \u0ab8\u0ac7\u0ab5\u0abe \u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f\u0ab0 \u0aaa\u0ab0 \u0a86\u0aaa\u0aa8\u0ac1\u0a82 \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0a85\u0aa5\u0ab5\u0abe \u0ab0\u0ab8\u0ac0\u0aa6 \u0aac\u0aa4\u0abe\u0ab5\u0ab5\u0abe \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0.",
        "P2": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0a96\u0abe\u0aa4\u0ac7 \u0a9f\u0abf\u0a95\u0abf\u0a9f/\u0ab0\u0abf\u0a9a\u0abe\u0ab0\u0acd\u0a9c \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0a86\u0aaa\u0aa8\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0ab0\u0ac7\u0ab5\u0aa8\u0acd\u0aaf\u0ac1 \u0a93\u0aa1\u0abf\u0a9f \u0a9f\u0ac0\u0aae \u0aaa\u0abe\u0ab8\u0ac7 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0a88 \u0a9b\u0ac7. \u0a96\u0abe\u0aa4\u0abe\u0aa8\u0ac0 \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0 \u0aa5\u0a88 \u0ab0\u0ab9\u0ac0 \u0a9b\u0ac7.",
        "P3": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, \u0aad\u0abe\u0aa1\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aaa\u0ac2\u0a9b\u0aaa\u0ab0\u0a9b (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0aa8\u0acb\u0a82\u0aa7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7."
      },
      "lifts_escalators": {
        "P1": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0a96\u0abe\u0aa4\u0ac7 \u0ab2\u0abf\u0aab\u0acd\u0a9f/\u0a8f\u0ab8\u0acd\u0a95\u0ac7\u0ab2\u0ac7\u0a9f\u0ab0\u0aa8\u0ac0 \u0a96\u0abe\u0aae\u0ac0 \u0a85\u0a82\u0a97\u0ac7\u0aa8\u0acb \u0a85\u0ab9\u0ac7\u0ab5\u0abe\u0ab2 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0a9f\u0ac7\u0a95\u0aa8\u0abf\u0a95\u0ab2 \u0a8f\u0aa8\u0acd\u0a9c\u0abf\u0aa8\u0abf\u0aaf\u0ab0\u0abf\u0a82\u0a97 \u0a9f\u0ac0\u0aae\u0aa8\u0ac7 \u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0acb \u0a9b\u0ac7.",
        "P2": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0aaa\u0ab0 \u0ab2\u0abf\u0aab\u0acd\u0a9f/\u0a8f\u0ab8\u0acd\u0a95\u0ac7\u0ab2\u0ac7\u0a9f\u0ab0\u0aa8\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0aa8\u0acb\u0a82\u0aa7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7. \u0a9c\u0abe\u0ab3\u0ab5\u0aa3\u0ac0 \u0a9f\u0ac0\u0aae \u0aa4\u0ac7\u0aa8\u0ac1\u0a82 \u0aa8\u0abf\u0ab0\u0ac0\u0a95\u0acd\u0ab7\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0ac0 \u0a9b\u0ac7.",
        "P3": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0a96\u0abe\u0aa4\u0ac7 \u0ab2\u0abf\u0aab\u0acd\u0a9f/\u0a8f\u0ab8\u0acd\u0a95\u0ac7\u0ab2\u0ac7\u0a9f\u0ab0 \u0aac\u0abe\u0aac\u0aa4\u0ac7 \u0a86\u0aaa\u0aa8\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0a88 \u0a9b\u0ac7."
      },
      "other": {
        "P1": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0a96\u0abe\u0aa4\u0ac7 \u0a86\u0aaa\u0aa8\u0acb \u0aae\u0ab9\u0aa4\u0acd\u0ab5\u0aa8\u0acb \u0aae\u0ac1\u0aa6\u0acd\u0aa6\u0acb (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0ab8\u0acd\u0a9f\u0ac7\u0ab6\u0aa8 \u0a95\u0a82\u0a9f\u0acd\u0ab0\u0acb\u0ab2\u0ab0\u0aa8\u0abe \u0aa7\u0acd\u0aaf\u0abe\u0aa8\u0ac7 \u0ab2\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0acb \u0a9b\u0ac7.",
        "P2": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, \u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0acb \u0a95\u0ab8\u0acd\u0a9f\u0aae\u0ab0 \u0a95\u0ac7\u0ab0\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aac\u0aa6\u0ab2 \u0a86\u0aad\u0abe\u0ab0 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}). \u0a86\u0aaa\u0aa8\u0ac0 \u0ab0\u0a9c\u0ac2\u0a86\u0aa4 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab5\u0abf\u0aad\u0abe\u0a97\u0aa8\u0ac7 \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0a9b\u0ac7.",
        "P3": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, \u0a86\u0aaa\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aad\u0abe\u0ab5 \u0a86\u0aaa\u0ab5\u0abe \u0aac\u0aa6\u0ab2 \u0a86\u0aad\u0abe\u0ab0 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id})."
      },
      "safety": {
        "P1": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0a96\u0abe\u0aa4\u0ac7 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a85\u0a82\u0a97\u0ac7\u0aa8\u0acb \u0a86\u0aaa\u0aa8\u0acb \u0a85\u0ab9\u0ac7\u0ab5\u0abe\u0ab2 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0ab8\u0acd\u0a9f\u0ac7\u0ab6\u0aa8 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0aa8\u0abf\u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0a95 \u0a85\u0aa8\u0ac7 \u0a88\u0aae\u0ab0\u0a9c\u0aa8\u0acd\u0ab8\u0ac0 \u0a9f\u0ac0\u0aae\u0aa8\u0ac7 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0acb \u0a9b\u0ac7. \u0ab8\u0acd\u0aa5\u0ab3\u0aa8\u0ac0 \u0a9a\u0a95\u0abe\u0ab8\u0aa3\u0ac0 \u0a9a\u0abe\u0ab2\u0ac1 \u0a9b\u0ac7. \u0a9c\u0acb \u0a86\u0aaa \u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0a9c\u0acb\u0a96\u0aae\u0aae\u0abe\u0a82 \u0ab9\u0acb\u0ab5 \u0aa4\u0acb \u0ab8\u0acd\u0a9f\u0ac7\u0ab6\u0aa8 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe\u0a95\u0ab0\u0acd\u0aae\u0ac0\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0acb.",
        "P2": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0aaa\u0ab0 \u0a86\u0aaa\u0aa8\u0ac0 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0ab8\u0ac1\u0aaa\u0ab0\u0ab5\u0abe\u0a88\u0a9d\u0ab0 \u0aaa\u0abe\u0ab8\u0ac7 \u0aa4\u0aaa\u0abe\u0ab8 \u0a85\u0ab0\u0acd\u0aa5\u0ac7 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0a88 \u0a9b\u0ac7. \u0aae\u0ac7\u0a9f\u0acd\u0ab0\u0acb \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0ab9\u0a95\u0abe\u0ab0 \u0a86\u0aaa\u0ab5\u0abe \u0aac\u0aa6\u0ab2 \u0a86\u0aad\u0abe\u0ab0.",
        "P3": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad\u0ac7 \u0a86\u0aaa\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aad\u0abe\u0ab5 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0aac\u0aa6\u0ab2 \u0a86\u0aad\u0abe\u0ab0. \u0aa4\u0ac7 \u0ab8\u0aae\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0aa1\u0ac7\u0ab8\u0acd\u0a95\u0aa8\u0ac7 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0acb \u0a9b\u0ac7."
      },
      "staff_behaviour": {
        "P1": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0a96\u0abe\u0aa4\u0ac7 \u0a95\u0ab0\u0acd\u0aae\u0a9a\u0abe\u0ab0\u0ac0 \u0ab5\u0ab0\u0acd\u0aa4\u0aa3\u0ac2\u0a95 \u0a85\u0a82\u0a97\u0ac7\u0aa8\u0ac0 \u0a86\u0aaa\u0aa8\u0ac0 \u0a97\u0a82\u0aad\u0ac0\u0ab0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0ab8\u0acd\u0a9f\u0ac7\u0ab6\u0aa8 \u0a93\u0aaa\u0ab0\u0ac7\u0ab6\u0aa8\u0acd\u0ab8 \u0aae\u0ac7\u0aa8\u0ac7\u0a9c\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa8\u0acb\u0a82\u0aa7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a86\u0a82\u0aa4\u0ab0\u0abf\u0a95 \u0aa4\u0aaa\u0abe\u0ab8 \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0abe\u0a88 \u0a9b\u0ac7.",
        "P2": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0a96\u0abe\u0aa4\u0ac7 \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95 \u0ab8\u0ac7\u0ab5\u0abe \u0a85\u0aa8\u0ac1\u0aad\u0ab5 \u0aac\u0abe\u0aac\u0aa4\u0ac7 \u0a86\u0aaa\u0aa8\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0ab8\u0acd\u0a9f\u0ac7\u0ab6\u0aa8 \u0ab8\u0ac1\u0aaa\u0ab0\u0abf\u0aa8\u0acd\u0a9f\u0ac7\u0aa8\u0acd\u0aa1\u0aa8\u0acd\u0a9f\u0aa8\u0ac7 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7.",
        "P3": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, \u0ab8\u0acd\u0a9f\u0abe\u0aab \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad\u0ac7 \u0a86\u0aaa\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aad\u0abe\u0ab5 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0ab8\u0ac7\u0ab5\u0abe \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0aa3\u0abe \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1 \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0abe \u0a9b\u0ac7."
      }
    },
    "hi": {
      "cleanliness": {
        "P1": "\u092a\u094d\u0930\u093f\u092f \u092f\u093e\u0924\u094d\u0930\u0940, {station} \u092a\u0930 \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e \u0938\u0902\u092c\u0902\u0927\u0940 \u0906\u092a\u0915\u0940 \u0905\u0924\u093f-\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0938\u0942\u091a\u0928\u093e (\u0938\u0902\u0926\u0930\u094d\u092d \u0938\u0902\u0916\u094d\u092f\u093e: {ticket_id}) \u0921\u094d\u092f\u0942\u091f\u0940 \u092a\u0930 \u092e\u094c\u091c\u0942\u0926 \u0938\u092b\u093e\u0908 \u091f\u0940\u092e \u0915\u094b \u0924\u094d\u0935\u0930\u093f\u0924 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0939\u0947\u0924\u0941 \u0906\u0935\u0902\u091f\u093f\u0924 \u0915\u0930 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964",
        "P2": "\u092a\u094d\u0930\u093f\u092f \u092f\u093e\u0924\u094d\u0930\u0940, \u0907\u0938 \u092e\u093e\u092e\u0932\u0947 \u0915\u094b \u0939\u092e\u093e\u0930\u0947 \u0938\u0902\u091c\u094d\u091e\u093e\u0928 \u092e\u0947\u0902 \u0932\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0927\u0928\u094d\u092f\u0935\u093e\u0926\u0964 {station} \u092a\u0930 \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e \u0936\u093f\u0915\u093e\u092f\u0924 (\u0938\u0902\u0926\u0930\u094d\u092d \u0938\u0902\u0916\u094d\u092f\u093e: {ticket_id}) \u0938\u092b\u093e\u0908 \u092a\u0930\u094d\u092f\u0935\u0947\u0915\u094d\u0937\u0915 \u0915\u094b \u092a\u094d\u0930\u0947\u0937\u093f\u0924 \u0915\u0930 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964",
        "P3": "\u092a\u094d\u0930\u093f\u092f \u092f\u093e\u0924\u094d\u0930\u0940, {station} \u092a\u0930 \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e \u0938\u0902\u092c\u0902\u0927\u0940 \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e (\u0938\u0902\u0926\u0930\u094d\u092d \u0938\u0902\u0916\u094d\u092f\u093e: {ticket_id}) \u0926\u0948\u0928\u093f\u0915 \u0930\u0916\u0930\u0916\u093e\u0935 \u0930\u091c\u093f\u0938\u094d\u091f\u0930 \u092e\u0947\u0902 \u0926\u0930\u094d\u091c \u0915\u0930 \u0932\u0940 \u0917\u0908 \u0939\u0948\u0964"
