    "gu": {
      "cleanliness": {
        "P1": "\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0, {station} \u0a96\u0abe\u0aa4\u0ac7 \u0ab8\u0aab\u0abe\u0a88 \u0a85\u0a82\u0a97\u0ac7\u0aa8\u0ac0 \u0a86\u0aaa\u0aa8\u0ac0 \u0aae\u0ab9\u0aa4\u0acd\u0ab5\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 (\u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad: {ticket_id}) \u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0aae\u0abe\u0a9f\u0ac7 \u0aa1\u0acd\u0aaf\u0ac1\u0a9f\u0ac0 \u0aaa\u0ab0 \u0ab9\u0abe\u0a9c\u0ab0 \u0ab9\u0abe\u0a89\u0ab8\u0a95\u0ac0\u0aaa\u0abf\u0a82\u0a97 \u0a9f\u0ac0\u0aae\u0aa8\u0ac7 \u0ab8\u0acb\u0a82\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7.",
